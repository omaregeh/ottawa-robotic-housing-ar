{
  "name": "ottawa-robotic-housing-ar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "inventory": "python3 tools/inventory.py",
    "optimize": "node tools/optimize.mjs",
    "validate": "node tools/validate.mjs",
    "test": "node tools/timeline.test.mjs",
    "test:browser": "node tools/smoke.mjs",
    "test:ar": "node tools/ar-smoke.mjs",
    "prepare:models": "blender --background --threads 4 --python tools/decimate_assets.py",
    "reports": "python3 tools/generate-reports.py",
    "build:pages": "vite build --mode github-pages",
    "validate:originals": "node tools/validate.mjs --require-originals",
    "check:repo": "node tools/check-repository.mjs",
    "originals:copy": "node tools/copy-originals.mjs",
    "preview:pages": "vite preview --mode github-pages --host 0.0.0.0"
  },
  "dependencies": {
    "three": "0.160.1",
    "mind-ar": "1.2.5",
    "qrcode": "1.5.4",
    "@msgpack/msgpack": "2.8.0"
  },
  "devDependencies": {
    "vite": "6.4.6",
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "meshoptimizer": "0.23.0",
    "sharp": "0.35.5",
    "@playwright/test": "1.56.1"
  },
  "description": "An Ottawa SDG 11 housing-awareness diorama using Three.js, MindAR and construction robotics.",
  "overrides": {
    "@mapbox/node-pre-gyp": {
      "tar": "7.5.23"
    }
  }
}
